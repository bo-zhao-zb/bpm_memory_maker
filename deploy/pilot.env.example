APP_ENV_FILE=/etc/bpm-memory-maker/pilot.env
APP_RELEASE=pilot-manual
DATABASE_ROOT_HOST=/srv/bpm-memory-maker/production/database
MEDIA_ROOT_HOST=/srv/bpm-memory-maker/production/media

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=bpmimage.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://bpmimage.com
DJANGO_MEDIA_ROOT=/srv/bpm-memory-maker/media
DATABASE_URL=sqlite:////srv/bpm-memory-maker/database/db.sqlite3
ALBUM_PHOTO_LIMIT=100
DRAFT_RETENTION_DAYS=30
PHOTO_MAX_FILE_SIZE=26214400
PHOTO_MAX_REQUEST_SIZE=28311552
PHOTO_MAX_FILES_PER_REQUEST=20
PHOTO_MAX_PIXELS=50000000
PHOTO_PREVIEW_MAX_DIMENSION=1600
PHOTO_PREVIEW_JPEG_QUALITY=85
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
