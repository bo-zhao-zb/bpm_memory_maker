DJANGO_DEBUG=true
APP_RELEASE=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Leave empty to use SQLite in development. CI also tests PostgreSQL.
DATABASE_URL=
# Required when DJANGO_DEBUG=false. Never use a real secret in this example file.
DJANGO_SECRET_KEY=
# Local-only media directory. Production uses a dedicated persistent mount.
DJANGO_MEDIA_ROOT=media
ALBUM_PHOTO_LIMIT=100
DRAFT_RETENTION_DAYS=30
PHOTO_MAX_FILE_SIZE=26214400
PHOTO_MAX_REQUEST_SIZE=28311552
PHOTO_MAX_FILES_PER_REQUEST=20
PHOTO_MAX_PIXELS=50000000
PHOTO_PREVIEW_MAX_DIMENSION=1600
PHOTO_PREVIEW_JPEG_QUALITY=85
# Optional social sign-in. Configure both values for each enabled provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=