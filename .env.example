DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Leave empty to use SQLite in development. CI also tests PostgreSQL.
DATABASE_URL=
# Required when DJANGO_DEBUG=false. Never use a real secret in this example file.
DJANGO_SECRET_KEY=
ALBUM_PHOTO_LIMIT=100
DRAFT_RETENTION_DAYS=30
# Optional social sign-in. Configure both values for each enabled provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=